# LINE Bot & Server
PORT=4000
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret
LINE_GROUP_ID=

# PostgreSQL (Primary Database)
PGHOST=localhost
PGPORT=5432
PGUSER=kyne
PGPASSWORD=your_pg_password
PGDATABASE=soccerbot
# Or single connection string:
# DATABASE_URL=postgres://kyne:password@localhost:5432/soccerbot

# Source MySQL (Only needed when running scripts/migrate-mysql-to-pg.js)
DB_HOST=localhost
DB_PORT=3306
DB_USER=kyne
DB_PASSWORD=your_mysql_password
DB_NAME=soccerbot

# Auth & EasySlip
SESSION_SECRET=change_me
ADMIN_USER=admin
ADMIN_PASSWORD=change_me
ROOT_USER=root
ROOT_PASSWORD=change_me
EASYSLIP_API_KEY=your_easyslip_api_key
